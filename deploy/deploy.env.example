# deploy/deploy.env — 서버에만 두는 설정(커밋하지 않는다). 이 파일을 복사해 고친다:
#   cp deploy/deploy.env.example deploy/deploy.env
# 비밀값(EVENT_* 토큰 · DATABASE_URL)은 여기가 아니라 앱이 읽는 환경변수(docker-compose의 env_file 등)에 둔다.

# 따라갈 브랜치
DEPLOY_BRANCH=main

# ── 방식 1: docker(기본) ── 저장소의 docker-compose.yml로 이미지를 다시 만들고 컨테이너를 갈아 끼운다.
DEPLOY_MODE=docker
DEPLOY_COMPOSE_FILE=docker-compose.yml

# ── 방식 2: command ── 서버가 docker 없이 node · pm2 · systemd로 돌고 있을 때. 예:
# DEPLOY_MODE=command
# DEPLOY_BUILD_CMD="npm ci --no-audit --no-fund && npm run build --workspace=client"
# DEPLOY_RESTART_CMD="pm2 restart card-battle"          # 또는 "sudo systemctl restart card-battle"

# 재시작 뒤 이 주소가 200을 줄 때까지 기다린다(비우면 확인하지 않음). nginx 뒤의 앱 포트를 적는다.
DEPLOY_HEALTH_URL=http://localhost:3000/
DEPLOY_HEALTH_TIMEOUT_SEC=180

# 배포 전에 기다릴 CI 작업 이름(.github/workflows/ci.yml의 jobs 키). 비우면 CI 결과를 보지 않고 배포한다.
# DEPLOY_CI_CHECK=test
